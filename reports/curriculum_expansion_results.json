        ]
      }
    },
    {
      "name": "Law of Gearing",
      "activation": 1.0,
      "metadata": {
        "description": "A condition for gears to transmit a constant angular velocity ratio, stating that the common normal at the point of contact must pass through the pitch point.",
        "difficulty": "Medium",
        "aliases": [],
        "synonyms": [],
        "sources": [
          "GATE Mechanical Engineering Syllabus Curriculum"
        ]
      }
    },
    {
      "name": "Logarithmic Decrement",
      "activation": 1.0,
      "metadata": {
        "description": "The natural logarithm of the ratio of any two successive amplitudes in a damped free vibration.",
