  "new_nodes": [
    {
      "name": "Cayley-Hamilton Theorem",
      "activation": 1.0,
      "metadata": {
        "description": "A mathematical theorem stating that every square matrix satisfies its own characteristic equation.",
        "difficulty": "Medium",
        "aliases": [
          "Cayley Hamilton theorem"
        ],
        "synonyms": [
          "Cayley-Hamilton formula"
        ],
        "sources": [
          "GATE Mechanical Engineering Syllabus Curriculum"
        ]
      }
    },
    {
      "name": "Virtual Work Principle",
      "activation": 1.0,
      "metadata": {
        "description": "A principle stating that for a system in static equilibrium under constraints, the virtual work done by external forces for any virtual displacement is zero.",
        "difficulty": "Hard",
        "aliases": [],
        "synonyms": [],
        "sources": [
          "GATE Mechanical Engineering Syllabus Curriculum"
        ]
      }
    },
    {
