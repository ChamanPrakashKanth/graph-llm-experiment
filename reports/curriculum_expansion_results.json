    {
      "name": "Clausius Inequality",
      "activation": 1.0,
      "metadata": {
        "description": "A thermodynamic theorem stating that the cyclic integral of heat transfer divided by absolute temperature is less than or equal to zero for any thermodynamic cycle.",
